# Copy to .env. `shopify app dev` provides SHOPIFY_API_KEY / SECRET / APP_URL
# in development; set them yourself in production.

DATABASE_URL="postgresql://bridge:bridge@localhost:5432/lbeauty_bridge"

# L-Beauty's own store. Every other store that installs is treated as a brand.
MARKETPLACE_SHOP="l-beauty.myshopify.com"

# Link brands open to connect. Once the unlisted App Store listing is approved,
# set this to the listing URL. Default: Shopify's direct install link for this app.
# BRAND_INSTALL_URL="https://apps.shopify.com/your-unlisted-handle"

# Slack (or compatible) incoming webhook for failures and new brand installs.
ALERT_WEBHOOK_URL=""

# Send the buyer's email to brand stores (default: no — brands get the address only).
SHARE_CUSTOMER_EMAIL="false"

# Cancel the brand order automatically when L-Beauty cancels, if it hasn't shipped.
AUTO_CANCEL_AT_BRAND="false"

# Labels shown in brand stores.
ORDER_TAG="L-Beauty"
CHANNEL_LABEL="L-Beauty Marketplace"

# Worker tuning: jobs processed in parallel per worker process.
WORKER_CONCURRENCY="8"
WORKER_POLL_MS="1000"

# Only needed if you process jobs from a cron instead of `npm run worker`.
CRON_SECRET=""

# Production only (the CLI sets these in development):
# SHOPIFY_API_KEY=""
# SHOPIFY_API_SECRET=""
# SHOPIFY_APP_URL="https://bridge.l-beauty.example"
# SCOPES="read_orders,write_orders,read_products,read_merchant_managed_fulfillment_orders,write_merchant_managed_fulfillment_orders"
